{
  "name": "@kingdomos/providers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "KingdomOS provider adapters: LM Studio, OpenAI-compatible",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "dependencies": {
    "@kingdomos/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
